# 复制为 deploy/.env 并填写。.env 已被 .gitignore 排除，不会入库。

# 公网必须改为实际域名（如 panel.example.com），DNS 指向主机并放行 TCP 80/443。
# :80 仅限受限内网调试，属于明文 HTTP；不会申请 HTTPS 证书。
SITE_ADDRESS=:80

# Caddy 宿主机 HTTP/HTTPS 端口；域名自动签证书的标准入口是 80/443。
WEB_PORT=80
WEB_HTTPS_PORT=443

# 数据库宿主机端口始终只绑定 127.0.0.1，不可改成公网监听。
PG_HOST_PORT=15432

# rentauto 仅为本机测试默认值；生产必须改为独立强随机密码（至少 20 字符）。
# 推荐 openssl rand -hex 20，避免 DATABASE_URL 中需要转义的特殊字符。
# POSTGRES_PASSWORD 只在空数据卷首次初始化时设置数据库角色密码。
# 已有库轮换：先在受信任终端执行 docker compose exec postgres psql -U rentauto -d postgres，
# 在 psql 内用 \password rentauto 交互式更新角色密码（不把明文放进 SQL/终端历史），
# 再同步本文件副本 .env 与所有 DATABASE_URL/TEST_DATABASE_URL，重新创建 backend/backup 容器。
# 绝不能通过删除 pgdata 或 docker compose down -v 改密码；这会删除业务数据和备份。
POSTGRES_PASSWORD=rentauto

# JWT 密钥：至少 32 字节随机串（openssl rand -hex 32）
JWT_SECRET=

# 凭证加密主密钥：32 字节 hex（openssl rand -hex 32）；不设则无法保存渠道凭证
# 已有加密凭证必须保留原值；数据库备份不包含此密钥，应独立受限备份。
APP_MASTER_KEY=

# 可选 bcrypt hash 外部托管（.env 值必须用单引号保护 $）；留空使用数据库密码及面板改密。
# 外部托管时面板改密返回 409；轮换该 hash 时同时轮换 JWT_SECRET 并重建 backend。
ADMIN_PASSWORD_HASH=

# Compose 的 ADMIN_BOOTSTRAP_FILE 固定为 /var/lib/rent-auto/admin-password，
# 持久化在 backend_data 卷，由 UID 10001 以 0600 权限创建；口令不会输出到日志。
# DB 尚无密码时可从合规的既有文件恢复中断初始化；DB 已有密码时不读取此文件。
# 首次登录后在面板改密，验证新密码登录成功后删除旧初始文件。
# 重建空数据库前必须先归档/删除旧初始文件，避免恢复旧口令。详见 release-runbook。

# 自动备份：启动立即执行；成功后等待 60..86400 秒，失败后等待 1..3600 秒。
# 完成的备份保留 14 天；pgbackups 卷不防主机损坏，仍需加密异机副本。
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETRY_SECONDS=300

# 新策略默认 dry-run
DRY_RUN_DEFAULT=true
LOG_LEVEL=info
